<% layout("/layouts/boilerplate") %>

<div class="error-page text-center py-5" data-aos="fade-up">
  <div class="error-code"><%= statusCode || 500 %></div>
  <div class="error-emoji">
    <% if (statusCode === 404) { %>🗺️<% } else { %>⚠️<% } %>
  </div>
  <h2 class="error-title">
    <% if (statusCode === 404) { %>Page Not Found<% } else { %>Something Went Wrong<% } %>
  </h2>
  <p class="text-muted error-msg"><%= message %></p>
  <div class="d-flex gap-3 justify-content-center mt-4">
    <a href="/listings" class="btn btn-wh btn-lg rounded-pill px-5">
      <i class="fa-solid fa-compass me-2"></i>Go Home
    </a>
    <button onclick="history.back()" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
      <i class="fa-solid fa-arrow-left me-2"></i>Go Back
    </button>
  </div>
</div>
