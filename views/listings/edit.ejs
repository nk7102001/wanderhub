<% layout("/layouts/boilerplate") %>

<div class="form-page container py-5" data-aos="fade-up">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="form-card">
        <div class="form-card-header">
          <i class="fa-solid fa-pen-to-square me-2"></i>
          <h3 class="mb-0">Update Listing</h3>
          <p class="text-muted small mt-1 mb-0">Make changes to your property listing</p>
        </div>
        <div class="form-card-body">
          <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">

            <div class="mb-4">
              <label class="form-label fw-semibold">Title</label>
              <input type="text" name="listing[title]" value="<%= listing.title %>" class="form-control form-control-lg rounded-3" required />
              <div class="invalid-feedback">Please enter a title</div>
            </div>

            <div class="mb-4">
              <label class="form-label fw-semibold">Description</label>
              <textarea name="listing[description]" class="form-control rounded-3" rows="4" required><%= listing.description %></textarea>
              <div class="invalid-feedback">Please add a description</div>
            </div>

            <div class="mb-4">
              <label class="form-label fw-semibold">Category</label>
              <select name="listing[category]" class="form-select form-select-lg rounded-3" required>
                <option value="">— Select a Category —</option>
                <% ["Trending","Rooms","Iconic Cities","Mountains","Beaches","Castles","Amazing Pools","Camping","Farms","Arctic","Luxury"].forEach(cat => { %>
                  <option value="<%= cat %>" <%= listing.category === cat ? "selected" : "" %>><%= cat %></option>
                <% }) %>
              </select>
              <div class="invalid-feedback">Please select a category</div>
            </div>

            <!-- Current image -->
            <div class="mb-4">
              <label class="form-label fw-semibold">Current Image</label>
              <div class="current-img-wrapper">
                <img src="<%= listing.image && listing.image.url ? listing.image.url : "" %>" alt="current" class="current-img rounded-3" />
              </div>
            </div>

            <!-- New image -->
            <div class="mb-4">
              <label class="form-label fw-semibold">Replace Image <span class="text-muted fw-normal">(optional)</span></label>
              <input type="file" name="image" class="form-control rounded-3" accept="image/*" />
            </div>

            <div class="row g-3 mb-4">
              <div class="col-md-4">
                <label class="form-label fw-semibold">Price per Night (₹)</label>
                <div class="input-group">
                  <span class="input-group-text">₹</span>
                  <input type="number" name="listing[price]" value="<%= listing.price %>" class="form-control" min="0" required />
                </div>
                <div class="invalid-feedback">Enter a valid price</div>
              </div>
              <div class="col-md-8">
                <label class="form-label fw-semibold">Country</label>
                <input type="text" name="listing[country]" value="<%= listing.country %>" class="form-control rounded-3" required />
                <div class="invalid-feedback">Enter a country</div>
              </div>
            </div>

            <div class="mb-4">
              <label class="form-label fw-semibold">Location</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fa-solid fa-location-dot"></i></span>
                <input type="text" name="listing[location]" value="<%= listing.location %>" class="form-control" required />
              </div>
              <div class="invalid-feedback">Enter a location</div>
            </div>

            <div class="d-flex gap-3 mt-2">
              <button class="btn btn-wh btn-lg rounded-pill px-5 flex-grow-1">
                <i class="fa-solid fa-floppy-disk me-2"></i>Save Changes
              </button>
              <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary btn-lg rounded-pill px-4">Cancel</a>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>
</div>
