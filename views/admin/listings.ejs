<% layout("/layouts/boilerplate") %>
<% const page = 'listings' %>
<div class="admin-wrapper">
  <%- include("../includes/admin-sidebar") %>
  <div class="admin-main">
    <div class="admin-topbar">
      <h4 class="mb-0 fw-bold"><i class="fa-solid fa-house me-2"></i>All Listings</h4>
      <a href="/listings/new" class="btn btn-wh btn-sm rounded-pill px-3">+ Add New</a>
    </div>
    <div class="admin-content">
      <div class="admin-card">
        <div class="table-responsive">
          <table class="table table-hover admin-table align-middle">
            <thead>
              <tr><th>Image</th><th>Title</th><th>Owner</th><th>Location</th><th>Price/night</th><th>Category</th><th>Actions</th></tr>
            </thead>
            <tbody>
              <% listings.forEach(l => { %>
              <tr>
                <td><img src="<%= l.image && l.image.url ? l.image.url : '' %>" class="admin-thumb" /></td>
                <td><a href="/listings/<%= l._id %>" class="fw-semibold text-dark"><%= l.title %></a></td>
                <td class="text-muted"><%= l.owner ? l.owner.username : "—" %></td>
                <td class="text-muted small"><%= l.location %>, <%= l.country %></td>
                <td class="fw-semibold">₹<%= l.price.toLocaleString("en-IN") %></td>
                <td><span class="badge bg-light text-dark border"><%= l.category %></span></td>
                <td>
                  <div class="d-flex gap-1">
                    <a href="/listings/<%= l._id %>/edit" class="btn btn-sm btn-outline-dark rounded-pill px-2">Edit</a>
                    <form action="/admin/listings/<%= l._id %>/delete" method="POST"
                      onsubmit="return confirm('Delete this listing?')">
                      <button class="btn btn-sm btn-outline-danger rounded-pill px-2">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
