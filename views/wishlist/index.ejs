<% layout("/layouts/boilerplate") %>

<div class="container py-5">
  <div class="page-header mb-4" data-aos="fade-right">
    <h1><i class="fa-solid fa-heart text-danger me-2"></i>My Wishlist</h1>
    <p class="text-muted">Places you've saved for later</p>
  </div>

  <% if (wishlist.length === 0) { %>
    <div class="empty-state" data-aos="fade-up">
      <i class="fa-regular fa-heart fa-3x text-muted mb-3"></i>
      <h4>Your wishlist is empty</h4>
      <p class="text-muted">Explore listings and tap the heart to save your favorites</p>
      <a href="/listings" class="btn btn-wh rounded-pill px-4 mt-2">
        <i class="fa-solid fa-compass me-2"></i>Start Exploring
      </a>
    </div>
  <% } else { %>
    <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
      <% for (let listing of wishlist) { %>
        <div class="col" data-aos="fade-up">
          <div class="listing-card-wrapper">
            <a href="/listings/<%= listing._id %>" class="listing-link">
              <div class="listing-card">
                <div class="card-img-wrapper">
                  <img src="<%= listing.image && listing.image.url ? listing.image.url : '' %>" class="listing-img" alt="<%= listing.title %>" loading="lazy" />
                  <div class="category-badge"><%= listing.category %></div>
                  <div class="img-overlay"></div>
                </div>
                <div class="listing-info">
                  <h6 class="listing-title"><%= listing.title %></h6>
                  <p class="listing-location">
                    <i class="fa-solid fa-location-dot me-1"></i>
                    <%= listing.location %>, <%= listing.country %>
                  </p>
                  <p class="listing-price">
                    <strong>₹<%= listing.price.toLocaleString("en-IN") %></strong>
                    <span class="text-muted"> / night</span>
                  </p>
                </div>
              </div>
            </a>
            <!-- Remove from wishlist -->
            <form action="/wishlist/toggle/<%= listing._id %>" method="POST" class="wishlist-quick-btn">
              <button type="submit" class="btn-wishlist-quick active-heart" title="Remove from wishlist">
                <i class="fa-solid fa-heart text-danger"></i>
              </button>
            </form>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
