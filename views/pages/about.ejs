<% layout("/layouts/boilerplate") %>
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8 text-center" data-aos="fade-up">
      <i class="fa-regular fa-compass fa-4x text-wh mb-3"></i>
      <h1 class="mb-3">About WanderHub</h1>
      <p class="lead text-muted">WanderHub is a community-driven travel platform where hosts share unique properties and travelers find extraordinary stays around the world.</p>
      <hr class="my-5">
      <div class="row g-4">
        <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
          <i class="fa-solid fa-globe fa-2x text-wh mb-3"></i>
          <h5>Global Reach</h5>
          <p class="text-muted">Discover stays in over 100 countries</p>
        </div>
        <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
          <i class="fa-solid fa-shield-halved fa-2x text-wh mb-3"></i>
          <h5>Safe & Secure</h5>
          <p class="text-muted">Verified hosts and secure bookings</p>
        </div>
        <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
          <i class="fa-solid fa-headset fa-2x text-wh mb-3"></i>
          <h5>24/7 Support</h5>
          <p class="text-muted">We're always here to help you</p>
        </div>
      </div>
      <a href="/listings" class="btn btn-wh btn-lg rounded-pill px-5 mt-4">Start Exploring</a>
    </div>
  </div>
</div>
