<% layout("/layouts/boilerplate") %>
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-6" data-aos="fade-up">
      <div class="form-card">
        <div class="form-card-header">
          <i class="fa-solid fa-envelope me-2"></i>
          <h3 class="mb-0">Contact Us</h3>
          <p class="text-muted small mt-1 mb-0">We'd love to hear from you</p>
        </div>
        <div class="form-card-body">
          <div class="mb-3"><label class="form-label fw-semibold">Name</label><input type="text" class="form-control rounded-3" placeholder="Your name" /></div>
          <div class="mb-3"><label class="form-label fw-semibold">Email</label><input type="email" class="form-control rounded-3" placeholder="you@example.com" /></div>
          <div class="mb-4"><label class="form-label fw-semibold">Message</label><textarea class="form-control rounded-3" rows="5" placeholder="How can we help?"></textarea></div>
          <button class="btn btn-wh w-100 rounded-pill" onclick="alert('Message sent! We will get back to you soon ✅')">Send Message</button>
        </div>
      </div>
    </div>
  </div>
</div>
