<% if(success && success.length){ %>
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
  <div class="toast wh-toast show align-items-center border-0" role="alert">
    <div class="d-flex">
      <div class="toast-body">
        <i class="fa-solid fa-circle-check text-success me-2"></i><%= success %>
      </div>
      <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>
<% } %>
<% if(error && error.length){ %>
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
  <div class="toast wh-toast-error show align-items-center border-0" role="alert">
    <div class="d-flex">
      <div class="toast-body">
        <i class="fa-solid fa-circle-exclamation text-danger me-2"></i><%= error %>
      </div>
      <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>
<% } %>
