<% layout("/layouts/boilerplate") %>

<div class="container py-5" data-aos="fade-up">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-7">

      <div style="background:white; border:1.5px solid #e5e5e5; border-radius:16px; overflow:hidden; box-shadow:0 4px 20px rgba(0,0,0,0.08);">
        
        <div style="padding:24px 32px 20px; border-bottom:1px solid #e5e5e5; background:#f7f7f7;">
          <i class="fa-solid fa-user-pen me-2"></i>
          <h3 class="mb-0 d-inline">Edit Profile</h3>
        </div>

        <div style="padding:28px 32px;">
          <form action="/profile?_method=PUT" method="POST" enctype="multipart/form-data">

            <!-- Avatar Upload -->
            <div class="text-center mb-4">
              <% if (user.avatar && user.avatar.url) { %>
                <img src="<%= user.avatar.url %>" class="profile-avatar mb-3" alt="avatar" id="avatarPreview" />
              <% } else { %>
                <div class="profile-initials-lg mx-auto mb-3" id="avatarPlaceholder">
                  <%= user.username.charAt(0).toUpperCase() %>
                </div>
                <img id="avatarPreview" class="profile-avatar mb-3 d-none" alt="Preview" />
              <% } %>
              <div>
                <label for="avatarInput" class="btn btn-outline-dark btn-sm rounded-pill px-3" style="cursor:pointer">
                  <i class="fa-solid fa-camera me-1"></i>Change Photo
                </label>
                <input type="file" name="avatar" id="avatarInput" class="d-none" accept="image/*" onchange="previewAvatar(this)" />
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Username</label>
              <input type="text" class="form-control rounded-3 bg-light" value="<%= user.username %>" disabled />
              <small class="text-muted">Username cannot be changed</small>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Email</label>
              <input type="email" name="email" value="<%= user.email %>" class="form-control rounded-3" required />
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Phone Number</label>
              <input type="tel" name="phone" value="<%= user.phone || '' %>" class="form-control rounded-3" placeholder="+91 98765 43210" />
            </div>

            <div class="mb-4">
              <label class="form-label fw-semibold">Bio</label>
              <textarea name="bio" class="form-control rounded-3" rows="3" placeholder="Tell others about yourself..."><%= user.bio || '' %></textarea>
            </div>

            <div class="d-flex gap-3">
              <button type="submit" class="btn btn-wh btn-lg rounded-pill flex-grow-1">
                <i class="fa-solid fa-floppy-disk me-2"></i>Save Changes
              </button>
              <a href="/profile" class="btn btn-outline-secondary btn-lg rounded-pill px-4">Cancel</a>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
function previewAvatar(input) {
  const preview = document.getElementById("avatarPreview");
  const placeholder = document.getElementById("avatarPlaceholder");
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = e => {
      preview.src = e.target.result;
      preview.classList.remove("d-none");
      if (placeholder) placeholder.classList.add("d-none");
    };
    reader.readAsDataURL(input.files[0]);
  }
}
</script>